<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reson</name>
  <version>0.1.0</version>
  <description>
    Motor vibration fault diagnosis pipeline: CSV replay -> FFT -> spectral
    fingerprint -> similarity/distance -> diagnosis + health index, published
    on standard ROS 2 diagnostics topics.
  </description>
  <maintainer email="you@example.com">reson</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>python3</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
